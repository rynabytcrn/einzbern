{
  "$id": "https://tcrn.dev/schemas/knowledge-core-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TCRN File-Native Knowledge Core V1",
  "oneOf": [
    {
      "$ref": "#/$defs/storeMarker"
    },
    {
      "$ref": "#/$defs/metadata"
    }
  ],
  "$defs": {
    "strictInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._:-]+$"
    },
    "sortedStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "storeMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "workspaceId",
        "eventHighWaterDigest",
        "version",
        "disposable",
        "authority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.knowledge-store.v1"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^(?:workspace|library):[a-f0-9]{24}$"
        },
        "eventHighWaterDigest": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disposable": {
          "const": true
        },
        "authority": {
          "const": "metadata-index-authority-body-separate"
        },
        "lastSweepAt": {
          "description": "Historical: the instant of the last 1.2.0 fitness sweep. Read, never written (TCRN-CROSS-SUB-258, TCRN-CROSS-SUB-308).",
          "$ref": "#/$defs/strictInstant"
        }
      }
    },
    "retirement": {
      "description": "Historical: the retirement record a 1.2.0 fitness sweep wrote into a card. Read, never written; the only retirement now is a later card naming this one with supersedes (TCRN-CROSS-SUB-308).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "reason",
        "retrievalCount",
        "referenceCount",
        "observedEvents",
        "windowDays",
        "windowStart",
        "windowEnd",
        "sweptAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.knowledge-retirement.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^knowledge:[a-f0-9]{24}$"
        },
        "reason": {
          "const": "zero-retrieval-zero-reference"
        },
        "retrievalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "referenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "windowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "windowStart": {
          "$ref": "#/$defs/strictInstant"
        },
        "windowEnd": {
          "$ref": "#/$defs/strictInstant"
        },
        "sweptAt": {
          "$ref": "#/$defs/strictInstant"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "externalKey",
        "scope",
        "projectId",
        "roleScopes",
        "category",
        "kind",
        "tags",
        "subject",
        "summary",
        "snippet",
        "accountableOwnerId",
        "sourceReferences",
        "sourceDigest",
        "linkedWorkIds",
        "linkedDecisionIds",
        "linkedGateIds",
        "linkedEvidenceIds",
        "lifecycle",
        "retrievalDisposition",
        "freshnessState",
        "lastVerified",
        "stalenessPolicy",
        "redactionDisposition",
        "exportDisposition",
        "authority",
        "sourceProvenance",
        "bodySha256",
        "bodyBytes",
        "revision",
        "updatedAt",
        "extensions"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tcrn.knowledge-unit-metadata.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^knowledge:[a-f0-9]{24}$"
        },
        "externalKey": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
        },
        "scope": {
          "enum": [
            "workspace",
            "project",
            "role"
          ]
        },
        "projectId": {
          "anyOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "roleScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "category": {
          "enum": [
            "architecture",
            "domain",
            "implementation",
            "standards",
            "testing",
            "workflow",
            "decision",
            "evidence"
          ]
        },
        "kind": {
          "enum": [
            "fact",
            "guide",
            "decision",
            "reference",
            "summary"
          ]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "accountableOwnerId": {
          "allOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "string",
              "pattern": "^owner:[A-Za-z0-9._:-]+$"
            }
          ]
        },
        "sourceReferences": {
          "allOf": [
            {
              "$ref": "#/$defs/sortedStringArray"
            },
            {
              "type": "array",
              "minItems": 0
            }
          ]
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^knowledge:[a-f0-9]{24}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "linkedWorkIds": {
          "allOf": [
            {
              "$ref": "#/$defs/sortedStringArray"
            },
            {
              "type": "array"
            }
          ]
        },
        "linkedDecisionIds": {
          "allOf": [
            {
              "$ref": "#/$defs/sortedStringArray"
            },
            {
              "type": "array"
            }
          ]
        },
        "linkedGateIds": {
          "allOf": [
            {
              "$ref": "#/$defs/sortedStringArray"
            },
            {
              "type": "array"
            }
          ]
        },
        "linkedEvidenceIds": {
          "allOf": [
            {
              "$ref": "#/$defs/sortedStringArray"
            },
            {
              "type": "array",
              "minItems": 0
            }
          ]
        },
        "lifecycle": {
          "description": "Every card is written active (TCRN-CROSS-SUB-308). candidate and retired are read on records written before, never written.",
          "enum": [
            "candidate",
            "active",
            "retired"
          ]
        },
        "retrievalDisposition": {
          "enum": [
            "default",
            "explicit-only",
            "excluded"
          ]
        },
        "promotionState": {
          "description": "Retained on historical records. New records omit this retired promotion marker.",
          "enum": [
            "candidate",
            "promoted",
            "rejected"
          ]
        },
        "freshnessState": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "lastVerified": {
          "anyOf": [
            {
              "$ref": "#/$defs/strictInstant"
            },
            {
              "type": "null"
            }
          ]
        },
        "stalenessPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumAgeDays",
            "unknownDisposition"
          ],
          "properties": {
            "maximumAgeDays": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "unknownDisposition": {
              "enum": [
                "fail-closed",
                "fail-open"
              ]
            }
          }
        },
        "redactionDisposition": {
          "const": "focused-reference-redaction-v1"
        },
        "exportDisposition": {
          "enum": [
            "metadata-only",
            "excluded"
          ]
        },
        "authority": {
          "const": "workspace-knowledge-metadata"
        },
        "sourceProvenance": {
          "const": "explicit-current-source-reference"
        },
        "bodySha256": {
          "$ref": "#/$defs/digest"
        },
        "bodyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "$ref": "#/$defs/strictInstant"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coexistsWith": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^knowledge:[a-f0-9]{24}$"
              },
              "description": "Canonical ascending knowledge IDs; runtime also verifies strict ordering."
            },
            "supersededBy": {
              "type": "string",
              "pattern": "^knowledge:[a-f0-9]{24}$"
            }
          }
        },
        "retirement": {
          "$ref": "#/$defs/retirement"
        },
        "expansions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "zh-CN": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fr": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "ja": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "ko": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
