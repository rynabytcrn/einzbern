{
  "schemaVersion": "tcrn.gate-containment.v1",
  "note": "The groups this roster lists remain the semantic roster. A top-level run invokes only the roots; each root's declared children are already judged by its command. TCRN-CROSS-MIN-149 removed helper-release and helper-suite when TCRN-CROSS-STORY-382 shrank the helper repository to its Skill payload and deleted the two scripts those groups ran. TCRN-CROSS-STORY-467 R2 (TCRN-CROSS-MIN-227 D3) removed engine-guards with the guard mutation check it ran.",
  "topLevel": [
    "engine-release",
    "platform-layout",
    "product-gates"
  ],
  "executionOrder": [
    "engine-release",
    "platform-layout",
    "product-gates"
  ],
  "groups": [
    {
      "id": "engine-release",
      "command": "node scripts/push-gate.mjs",
      "contains": [
        "engine-p1",
        "engine-p8"
      ]
    },
    {
      "id": "engine-p1",
      "command": "pnpm verify:p1",
      "contains": [
        "engine-suite"
      ]
    },
    {
      "id": "engine-p8",
      "command": "pnpm verify:p8",
      "contains": []
    },
    {
      "id": "engine-suite",
      "command": "pnpm test",
      "contains": [],
      "cwd": ".",
      "executable": "pnpm",
      "argv": [
        "run",
        "--silent",
        "test"
      ]
    },
    {
      "id": "platform-layout",
      "command": "node scripts/platform-doctor.mjs --platform-root <container>",
      "contains": [
        "chain-validate"
      ]
    },
    {
      "id": "chain-validate",
      "command": "for each partition: einzbern validate --workspace <partition>/workspace",
      "contains": []
    },
    {
      "id": "product-gates",
      "command": "pnpm verify",
      "contains": []
    }
  ]
}
