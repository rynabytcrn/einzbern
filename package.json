{
  "name": "einzbern",
  "version": "2.0.3",
  "private": true,
  "description": "The Grail grants wishes. Einzbern remembers the wishes you made, the decisions you took, and the traps you fell into, and puts them in front of the model right before the prompt that needs them. For Claude Code and Codex.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.3.0"
  },
  "packageManager": "pnpm@11.3.0",
  "bin": {
    "einzbern": "scripts/einzbern.mjs",
    "einzbern-release-verify": "scripts/verify-release-trust.mjs"
  },
  "scripts": {
    "archive": "node scripts/task.mjs archive",
    "build": "node scripts/task.mjs build",
    "bundle": "node scripts/bundle.mjs",
    "clean": "node scripts/task.mjs clean",
    "format": "node scripts/task.mjs format-write",
    "format:check": "node scripts/task.mjs format-check",
    "lint": "node scripts/task.mjs lint",
    "pack:release": "node scripts/pack-release.mjs",
    "platform:doctor": "node scripts/platform-doctor.mjs",
    "portal": "node portal/portal.mjs",
    "portal:launchers": "node portal/scripts/generate-launchers.mjs",
    "portal:proof": "node portal/scripts/proof.mjs",
    "portal:test": "node --test portal/tests/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "push-gate": "node scripts/push-gate.mjs",
    "release": "node scripts/release.mjs",
    "release:preflight": "node scripts/task.mjs release-preflight",
    "sbom": "node scripts/task.mjs sbom",
    "test": "node scripts/task.mjs test",
    "test-wiring:proof": "node scripts/test-wiring-proof.mjs",
    "typecheck": "node scripts/task.mjs typecheck",
    "verify:isolated": "node scripts/isolated-proof.mjs",
    "report:ceremony-cost": "node scripts/ceremony-cost.mjs --manifest scripts/policy/ceremony-cost-init048.json",
    "batch:formal": "node scripts/operational-batch-entry.mjs",
    "research:compaction": "node scripts/compaction-prototype.mjs",
    "verify:no-sibling-dependency": "node scripts/task.mjs no-sibling-dependency",
    "verify:offline": "node scripts/task.mjs offline",
    "verify:p1": "node scripts/task.mjs verify-p1",
    "verify:p8": "node scripts/task.mjs p8",
    "verify:portal": "node scripts/verify-portal.mjs",
    "verify:privacy": "node scripts/task.mjs privacy",
    "privacy:staged": "node scripts/verify-staged-privacy.mjs",
    "verify:links": "node scripts/task.mjs links",
    "verify:retrieval-eval": "node scripts/task.mjs retrieval-eval"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "ajv": "8.20.0",
    "linkedom": "0.18.12",
    "typescript": "5.9.3"
  }
}
