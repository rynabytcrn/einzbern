{
  "$id": "https://tcrn.dev/schemas/event-integrity-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TCRN Event Integrity V1",
  "type": "object",
  "additionalProperties": false,
  "x-tcrn-aos-requirementIds": [
    "AOS-REQ-007"
  ],
  "required": [
    "schemaVersion",
    "id",
    "streamId",
    "sequence",
    "occurredAt",
    "priorHash",
    "payload",
    "payloadHash",
    "eventHash"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "tcrn.event.v1",
        "einzbern.event.v1"
      ]
    },
    "id": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/stableId"
    },
    "streamId": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/stableId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "clock": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "occurredAt": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/strictInstant"
    },
    "priorHash": {
      "anyOf": [
        {
          "$ref": "./protocol-common-v1.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/jsonValue"
    },
    "payloadHash": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/sha256"
    },
    "eventHash": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "einzbern.event.v1"
          }
        }
      },
      "then": {
        "properties": {
          "clock": true,
          "deviceId": true
        },
        "required": [
          "clock",
          "deviceId"
        ]
      },
      "else": {
        "properties": {
          "clock": false,
          "deviceId": false
        }
      }
    }
  ]
}
