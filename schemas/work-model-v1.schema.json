{
  "$id": "https://tcrn.dev/schemas/work-model-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TCRN Work Model V1",
  "$comment": "A stored work record of any kind reads, including every Incident, Release, Review and Knowledge record already on a chain. Since TCRN-CROSS-STORY-472 R1 a write creates only Initiative, Epic, Story and Subtask records (WORK_KIND_RETIRED otherwise). Relations are fields (STORY-472 R2): parentId, the advisory:decided-by minutes list (decided-in), and the required:false extension advisory:relations whose value is $defs/relationsExtensionValue; the reverse relations are projected on read and never stored.",
  "type": "object",
  "additionalProperties": false,
  "x-tcrn-aos-requirementIds": [
    "AOS-REQ-004",
    "AOS-REQ-005"
  ],
  "required": [
    "schemaVersion",
    "id",
    "externalKey",
    "projectId",
    "kind",
    "parentId",
    "status",
    "revision",
    "updatedAt",
    "tombstone",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tcrn.work.v1"
    },
    "id": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/stableId"
    },
    "externalKey": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/canonicalExternalKey"
    },
    "projectId": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/stableId"
    },
    "kind": {
      "$comment": "All eight kinds are valid stored records; new records take only Initiative, Epic, Story or Subtask (TCRN-CROSS-STORY-472 R1).",
      "enum": [
        "Initiative",
        "Epic",
        "Story",
        "Subtask",
        "Review",
        "Incident",
        "Release",
        "Knowledge"
      ]
    },
    "parentId": {
      "anyOf": [
        {
          "$ref": "./protocol-common-v1.schema.json#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "active",
        "blocked",
        "pending-owner-acceptance",
        "done",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/strictInstant"
    },
    "tombstone": {
      "type": "boolean"
    },
    "extensions": {
      "$ref": "./protocol-common-v1.schema.json#/$defs/extensionMap"
    },
    "scopeDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "anyOf": [
        {
          "$ref": "./protocol-common-v1.schema.json#/$defs/strictInstant"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "involvedProjects": {
      "$ref": "#/$defs/involvedProjects"
    }
  },
  "$defs": {
    "relationsExtensionValue": {
      "$comment": "The value of the advisory:relations extension (TCRN-CROSS-STORY-472 R2): the forward relations blocked-by, implements, supersedes and fixes. Each list is sorted in utf8-byte-order-v1, holds no repeats and never names the record itself.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "blockedBy": {
          "$ref": "#/$defs/relationTargets"
        },
        "implements": {
          "$ref": "#/$defs/relationTargets"
        },
        "supersedes": {
          "$ref": "#/$defs/relationTargets"
        },
        "fixes": {
          "$ref": "#/$defs/relationTargets"
        }
      }
    },
    "relationTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./protocol-common-v1.schema.json#/$defs/stableId"
      }
    },
    "projectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libraryId",
        "projectId"
      ],
      "properties": {
        "libraryId": {
          "type": "string",
          "pattern": "^(library|workspace):[a-f0-9]{24}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^project:[a-f0-9]{24}$"
        }
      }
    },
    "involvedProjects": {
      "$comment": "Absence reads undecided without replay backfill. Targets are canonical UTF-8 sorted by libraryId/projectId; the reducer enforces order and declared parent scope, independently of device registration.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "targets"
          ],
          "properties": {
            "state": {
              "enum": [
                "undecided",
                "coordination-only"
              ]
            },
            "targets": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "targets"
          ],
          "properties": {
            "state": {
              "const": "selected"
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/projectReference"
              }
            }
          }
        }
      ]
    }
  },
  "dependentRequired": {
    "scopeDigest": [
      "scopeDigest",
      "title",
      "createdAt",
      "labels"
    ],
    "title": [
      "scopeDigest",
      "title",
      "createdAt",
      "labels"
    ],
    "createdAt": [
      "scopeDigest",
      "title",
      "createdAt",
      "labels"
    ],
    "labels": [
      "scopeDigest",
      "title",
      "createdAt",
      "labels"
    ],
    "summary": [
      "scopeDigest",
      "title",
      "createdAt",
      "labels"
    ]
  }
}
