{
  "$id": "https://tcrn.dev/schemas/template-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TCRN minimum-content work template V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "appliesTo",
    "headings",
    "acceptanceHeadings",
    "referenceHeadings",
    "couplings",
    "contentSchema"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tcrn.template.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Epic",
          "Initiative",
          "Story",
          "Subtask"
        ]
      }
    },
    "headings": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceHeadings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referenceHeadings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "couplings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "owner-decider-minutes"
        ]
      }
    },
    "contentSchema": {
      "const": "tcrn.work-content.v1"
    }
  }
}
